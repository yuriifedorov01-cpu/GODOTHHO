; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Helmet Heroes"
config/version="9.50"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=30
config/icon="res://icon.png"

[autoload]

GameConfig="*res://scripts/autoload/GameConfig.gd"
StarlingAtlasLoader="*res://scripts/autoload/StarlingAtlasLoader.gd"
StatsDB="*res://scripts/autoload/StatsDB.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
PlayerIOClient="*res://scripts/network/PlayerIOClient.gd"
SwfSpriteLoader="*res://scripts/autoload/SwfSpriteLoader.gd"

[display]

window/size/viewport_width=950
window/size/viewport_height=700
window/size/window_width_override=950
window/size/window_height_override=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-mcp/plugin.cfg")

